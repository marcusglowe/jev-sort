{
  "name": "jev-sort",
  "version": "0.1.0",
  "description": "Semantic sorting with O(n) Jev Score batches and optional pairwise refinement.",
  "keywords": [
    "jev",
    "typesafe",
    "semantic-sort",
    "score",
    "quicksort",
    "bitonic-sort",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcusglowe/jev-sort.git"
  },
  "homepage": "https://github.com/marcusglowe/jev-sort#readme",
  "bugs": {
    "url": "https://github.com/marcusglowe/jev-sort/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./quicksort": {
      "types": "./dist/quicksort.d.ts",
      "import": "./dist/quicksort.js"
    },
    "./bitonic": {
      "types": "./dist/bitonic.d.ts",
      "import": "./dist/bitonic.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.5.7"
  }
}
